APP_ENV=dev
LOG_LEVEL=INFO

SOURCE_ACCESS_MODE=disabled
CAPTURE_MODE=visible_download_or_rendered
ALLOW_VISIBLE_DOWNLOAD=true
ALLOW_NETWORK_EXTRACTION=false
ALLOW_SOCIAL_WRITE_ACTIONS=false
ALLOW_STEALTH=false
ALLOW_CAPTCHA_BYPASS=false
ALLOW_COOKIE_EXPORT=false
ALLOW_RAW_IMAGE_PERSISTENCE=false
AUTHORIZATION_REFERENCE=

BROWSER_HEADLESS=true
BROWSER_PROFILE_ROOT=/data/profiles
BROWSER_ARTIFACT_ROOT=/data/artifacts
BROWSER_ASSET_ROOT=/data/assets
BROWSER_MAX_RESULTS=30
BROWSER_MAX_SCROLLS=5
BROWSER_MAX_FRAMES_PER_NOTE=30
BROWSER_STEP_TIMEOUT_SECONDS=30
BROWSER_MAX_RUN_SECONDS=900
SELECTOR_CONFIG_PATH=configs/selectors/xhs_web.yaml

QUERY_SOURCE_MODE=feishu_cli
FEISHU_BASE_URL=https://joy-group.feishu.cn/base/JyNJbS9ZEa56FYsBtOsc7XIfn7C?table=tblTgFj5ZsQpsUvx&view=vewFysg2sj
FEISHU_CLI_BIN=lark-cli
FEISHU_IDENTITY=user
FEISHU_QUERY_LIMIT=200

VISION_PROVIDER_MODE=disabled
RAW_ASSET_TTL_HOURS=24
FAILURE_SCREENSHOT_TTL_DAYS=14
TRACE_TTL_DAYS=7
